{
  "name": "nonotion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @nonotion/web dev",
    "dev:api": "pnpm --filter @nonotion/api dev",
    "build": "pnpm --filter @nonotion/web build",
    "lint": "eslint . && prettier --check . && pnpm --filter @nonotion/api lint",
    "format": "prettier --write . && pnpm --filter @nonotion/api format",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
