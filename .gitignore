# Dépendances
node_modules/
apps/api/vendor/

# Builds
dist/
dist-sandbox/
dist-desktop/
dist-mobile/
*.tsbuildinfo

# Secrets : le .env du serveur n'est jamais versionné (spec 1.6.9)
.env
.env.*
!.env.example
!.env.production.example
# Adresse publique de l'API pour l'application pour ordinateur (aucun secret).
!apps/web/.env.desktop
!apps/web/.env.mobile
deploy.env

# Front compilé copié dans le public Laravel par deploy.sh
apps/api/public/index.html
apps/api/public/assets/
apps/api/public/manifest.webmanifest
apps/api/public/sw.js
apps/api/public/workbox-*.js

# Fichiers des utilisateurs (vivent sur le serveur)
apps/api/public/uploads/*
!apps/api/public/uploads/.gitkeep
apps/api/public/downloads/*
!apps/api/public/downloads/.gitkeep

# Tests
test-results/
playwright-report/
coverage/

# Outils
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Réglages locaux de Claude Code
.claude/

# Natif : généré (icônes Tauri) ou compilé. Les projets Android et iOS sont versionnés (phase 10),
# sans ce que « cap sync » y recopie (le site compilé, la configuration) ni les icônes générées.
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/icons/
apps/desktop/src-tauri/gen/
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/app/src/main/assets/capacitor.config.json
apps/mobile/android/app/src/main/assets/capacitor.plugins.json
apps/mobile/android/app/src/main/res/xml/config.xml
apps/mobile/ios/App/App/capacitor.config.json
apps/mobile/ios/App/App/config.xml
