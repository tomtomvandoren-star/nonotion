# Copier en deploy.env (non versionné) et remplir. Aucun mot de passe ici : l'accès SSH se fait par clé.
DEPLOY_HOST=xxxx.ftp.infomaniak.com
DEPLOY_USER=xxxx_utilisateur
DEPLOY_PORT=22
DEPLOY_PATH=sites/nonotion.example.com
DEPLOY_URL=https://nonotion.example.com
# DEPLOY_SSH_KEY=~/.ssh/nonotion_deploy
# Sur Infomaniak, le « php » de SSH n'est pas forcément la version du site : la forcer.
# REMOTE_PHP=/opt/php8.5/bin/php
# REMOTE_COMPOSER=/opt/php8.5/bin/composer
