APP_NAME=Nonotion
APP_ENV=local
# Générée par « php artisan key:generate ». À SAUVEGARDER : elle chiffre les liens d'agenda ICS.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Adresse publique du front (liens des e-mails de réinitialisation)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nonotion
DB_USERNAME=root
DB_PASSWORD=

# Origines autorisées à appeler l'API (séparées par des virgules).
# Le web en production est sur la même origine ; les WebViews Tauri/Capacitor s'ajouteront en phase 8/9.
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Pas de worker permanent sur l'hébergement mutualisé : les tâches s'exécutent dans la requête ou via le cron.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nonotion@example.com"
MAIL_FROM_NAME="${APP_NAME}"
