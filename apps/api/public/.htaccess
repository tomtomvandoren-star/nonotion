# Nonotion : le dossier racine du site pointe ici (spec 1.8).
# Règles de réécriture, dans cet ordre :
#   1. /api/*                         -> index.php (Laravel)
#   2. fichier ou dossier existant    -> servi tel quel (front compilé, uploads/, downloads/)
#   3. tout le reste                  -> index.html (routes de la SPA, ex. /p/abc123)

# « / » sert la SPA, pas Laravel.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 1. API -> front controller Laravel
    RewriteRule ^api(/.*)?$ index.php [L]

    # 2. Fichier ou dossier existant -> servi tel quel
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Tout le reste -> la SPA
    RewriteRule ^ index.html [L]
</IfModule>

# Compression (spec 1.6.11 : appels réseau économes)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/calendar
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
    AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Les fichiers de assets/ ont un hash dans leur nom : cache d'un an.
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Le point d'entrée doit toujours être revalidé pour récupérer le dernier déploiement.
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
