# Modèle du .env de production. Sur le serveur : cp .env.production.example .env,
# remplir les valeurs, puis « php artisan key:generate ».
# Ce fichier ne contient aucun secret ; le .env rempli n'est JAMAIS versionné.
APP_NAME=Nonotion
APP_ENV=production
# Générée sur le serveur. À SAUVEGARDER hors du serveur : sans elle, les liens d'agenda chiffrés sont perdus.
APP_KEY=
APP_DEBUG=false
APP_URL=https://nonotion.example.com
FRONTEND_URL=https://nonotion.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base créée dans le Manager Infomaniak (Hébergement > Bases de données)
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Le web est sur la même origine que l'API. Origines Tauri / Capacitor à ajouter en phases 8 et 9.
CORS_ALLOWED_ORIGINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Planificateur : le Planificateur de tâches du Manager appelle GET /api/cron avec ces identifiants
# (option « URL protégée par mot de passe »). Mot de passe généré par deploy.sh au premier envoi.
CRON_USER=nonotion-cron
CRON_PASSWORD=

# SMTP Infomaniak (réinitialisation des mots de passe, phase 1)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
