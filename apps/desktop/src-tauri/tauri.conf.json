{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nonotion",
  "version": "0.1.0",
  "identifier": "be.thomasvandoren.nonotion",
  "build": {
    "frontendDist": "../../web/dist-sandbox"
  },
  "app": {
    "windows": [
      {
        "title": "Nonotion · éditeur (test)",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
